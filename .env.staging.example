# =================================================================
# Roktodata — STAGING Environment Configuration
# =================================================================
# ⚠️ Staging Environment Guidelines:
# - Connect to a SEPARATE Supabase Staging Project.
# - DO NOT copy real patient names, phones, or prescription photos from Production.
# - Use synthetic test numbers (e.g., 01700-000001 to 01700-000020) and dummy prescription images.
# - Keep credentials secret: NEVER commit this file as .env.local to GitHub.

# Staging App URL (Local or Preview deployment)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ENV="staging"

# Staging Supabase Project (Create a separate free project at supabase.com)
NEXT_PUBLIC_SUPABASE_URL="https://your-staging-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-staging-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-staging-service-role-key-here"

# Web Push Notification Staging Keys (Test VAPID keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-staging-vapid-public-key"
VAPID_PRIVATE_KEY="your-staging-vapid-private-key"
VAPID_SUBJECT="mailto:staging-admin@roktodata.org"
