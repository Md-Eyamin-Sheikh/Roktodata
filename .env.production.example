# =================================================================
# Roktodata — PRODUCTION Environment Configuration
# =================================================================
# ⚠️ Production Environment Guidelines:
# - Connect to the Live Production Supabase Project.
# - Enforce strict Row Level Security (RLS) on all tables.
# - Production Google OAuth redirect URI must match NEXT_PUBLIC_APP_URL/auth/callback.
# - Storage bucket 'prescriptions' must be PRIVATE with signed URL expiration.
# - NEVER commit secrets or service role keys to Git.

# Production App URL (Canonical Live Domain)
NEXT_PUBLIC_APP_URL="https://roktodata.org"
NEXT_PUBLIC_ENV="production"

# Production Supabase Project Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-production-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-production-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-production-service-role-key-here"

# Web Push Notification Production VAPID Keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-production-vapid-public-key"
VAPID_PRIVATE_KEY="your-production-vapid-private-key"
VAPID_SUBJECT="mailto:security@roktodata.org"
